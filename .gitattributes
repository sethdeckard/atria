# Auto detect text files and ensure LF line endings
* text=auto eol=lf

# Go source
*.go text diff=golang

# Binary files
*.gif binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Protobuf generated code — less noisy diffs
*.pb.go -diff linguist-generated=true

# VHS demo tape
*.tape text

# Shell scripts
*.sh text eol=lf
